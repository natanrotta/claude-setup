# Claude Code worktrees
.claude/worktrees/

# Claude Code runtime artifacts (never commit)
.claude/scheduled_tasks.lock
.claude/*.lock

# Local settings overrides (developer-specific permissions, env vars)
.claude/settings.local.json

# Claude Code local secrets — any Claude-Code-only credential lives here.
# NEVER versioned; only the *.example templates + .gitkeep are committed.
.claude/.secrets/*
!.claude/.secrets/*.example
!.claude/.secrets/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
